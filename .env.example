# Copy this file to .env and fill in real values. Never commit the real .env.

# From the Discord Developer Portal → your application → Bot → Token
BOT_TOKEN=your-bot-token-here

# Optional: your server's ID, for instant slash-command sync while testing.
# Right-click your server icon → Copy Server ID (Developer Mode must be on).
# Leave blank to sync globally (takes up to an hour to propagate).
GUILD_ID=

# --- Scheduled welcome message ---
# Channel ID of the public channel to post in (right-click channel → Copy Channel ID)
WELCOME_CHANNEL_ID=
# How often to post it, in hours (24 = once a day, 6 = 4x a day, etc.)
WELCOME_INTERVAL_HOURS=2

# Leave WELCOME_MESSAGE blank to use the built-in NusaKlip welcome text in bot.py
# (rules / panduan-gratis-content-rewards / capcut-pro). To make those real
# clickable channel links instead of plain #text, fill in their channel IDs
# below (right-click each channel → Copy Channel ID). Leave any of them blank
# and that one just stays as plain text.
RULES_CHANNEL_ID=
GUIDE_CHANNEL_ID=
CAPCUT_CHANNEL_ID=

# Or override the whole message yourself (supports \n for new lines, emoji,
# and <#channelID> for clickable channel mentions):
WELCOME_MESSAGE=

# --- Ticket system ---
# Category ID new ticket channels should be created under (optional)
TICKET_CATEGORY_ID=
# Hours of no new messages before a ticket auto-closes
TICKET_INACTIVITY_HOURS=48
# How often the bot checks tickets for inactivity, in minutes
TICKET_CHECK_INTERVAL_MINUTES=15
# How many hours before close to post a one-time warning
TICKET_WARNING_HOURS_BEFORE_CLOSE=4

# --- Bulk archive of old ticket channels (/arsip cek, /arsip jalankan) ---
# Private, staff-only channel where transcripts (.zip) are uploaded before deletion
ARCHIVE_CHANNEL_ID=
# Channel names starting with any of these get archived (comma-separated)
ARCHIVE_NAME_PREFIXES=closed-,selesai

# --- Buka Akses: purchase flow (/akses panel, /akses cek) ---
# Category where private payment rooms are created
PURCHASE_CATEGORY_ID=
# Role that verifies payments and gets pinged (e.g. @Sales or @Admin)
STAFF_ROLE_ID=
# Roles given after verification
BLUEPRINT_ROLE_ID=
MENTORING_ROLE_ID=
# Optional: move verified mentoring rooms into this category
MENTORING_CATEGORY_ID=
# Optional: staff-only channel that gets a record of every verified purchase
PURCHASE_LOG_CHANNEL_ID=
# Payment is QRIS only (assets/qris.png). Optional fallback image link:
QRIS_IMAGE_URL=
# Auto-close timings (hours) and check interval (minutes)
PURCHASE_INACTIVITY_HOURS=24
PURCHASE_WARNING_HOURS_BEFORE_CLOSE=4
PURCHASE_CLOSE_AFTER_VERIFY_HOURS=24
PURCHASE_CHECK_INTERVAL_MINUTES=15
# Welcome message sent on verification (channel links; plain #name text if empty)
WHOP_URL=https://whop.com/nusaklip
VIP_GUIDE_CHANNEL_ID=
BOOKING_CHANNEL_ID=
HELP_CHANNEL_ID=

# Extra channel links in the welcome post (plain #name text if empty)
CONTENT_REWARDS_CHANNEL_ID=
BLUEPRINT_CHANNEL_ID=
MENTORING_CHANNEL_ID=
CONSULT_CHANNEL_ID=
# Delete the previous welcome post when posting a new one (true/false)
WELCOME_DELETE_PREVIOUS=true

# --- Konsultasi Akses tickets (/konsultasi panel) ---
# Category for consult tickets (empty = same category as the panel channel)
CONSULT_CATEGORY_ID=
CONSULT_INACTIVITY_HOURS=24
CONSULT_FORCE_CLOSE_HOURS=12
CONSULT_CHECK_INTERVAL_MINUTES=15
