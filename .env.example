# Copy this file to .env and fill in real values. Never commit the real .env.

# From the Discord Developer Portal → your application → Bot → Token
BOT_TOKEN=your-bot-token-here

# Optional: your server's ID, for instant slash-command sync while testing.
# Right-click your server icon → Copy Server ID (Developer Mode must be on).
# Leave blank to sync globally (takes up to an hour to propagate).
GUILD_ID=

# --- Scheduled welcome message ---
# Channel ID of the public channel to post in (right-click channel → Copy Channel ID)
WELCOME_CHANNEL_ID=
WELCOME_MESSAGE=Welcome to the community! Check the pinned posts to get started.
# How often to post it, in hours (24 = once a day)
WELCOME_INTERVAL_HOURS=24

# --- Ticket system ---
# Category ID new ticket channels should be created under (optional)
TICKET_CATEGORY_ID=
# Hours of no new messages before a ticket auto-closes
TICKET_INACTIVITY_HOURS=48
# How often the bot checks tickets for inactivity, in minutes
TICKET_CHECK_INTERVAL_MINUTES=15
# How many hours before close to post a one-time warning
TICKET_WARNING_HOURS_BEFORE_CLOSE=4
